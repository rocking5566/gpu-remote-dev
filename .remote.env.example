# Remote GPU build target. Copy to .remote.env, which is gitignored, so that
# swapping machines never shows up as a repo change:
#
#     cp .remote.env.example .remote.env

# ssh target. Moves whenever the reservation lands on another box.
REMOTE_HOST=user@gpu-host.example

# Container on REMOTE_HOST carrying the ROCm toolchain.
REMOTE_CONTAINER=mi450_rocking_env

# REMOTE_PATH: rsync's destination on REMOTE_HOST (bind-mounted at /work in the container).
# CONTAINER_PATH: same tree, but the path used to cd/run commands inside the container.
REMOTE_PATH='~/work/gpu-remote-dev'
CONTAINER_PATH=/work/gpu-remote-dev

# Everything that lives on one side only, or that must not be mirrored. Build
# output and agent state come back on their own. artitoken is a credential held
# only on the remote.
RSYNC_EXCLUDES="--exclude build/ --exclude .rocprofv3/ --exclude .git/
--exclude .claude/ --exclude .codex/ --exclude .superpowers/"
